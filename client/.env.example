# ---------------------------------------------------------------------------
# TripMate client (Vite) environment variables
# Copy to `.env` and fill in the values. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Base URL of the TripMate API (Express + MongoDB + Gemini).
# Local development:
VITE_API_URL=http://localhost:5000
# Production example:
# VITE_API_URL=https://api.tripmate.example.com

# Mapbox GL access token. Optional - without it the map falls back to the
# free CARTO raster style instead of failing to render.
VITE_MAPBOX_TOKEN=

# Firebase (used for Google sign-in and the protected routes)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
